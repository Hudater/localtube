<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- SMB access happens over the local network, not general internet,
         but Android does not distinguish — both permissions are needed
         for smbj sockets to work. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Required for WorkManager's periodic background scan to survive
         Doze/app-standby restrictions on the schedule the user configures. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Media playback: PlaybackService (MediaSessionService) runs as a
         foreground mediaPlayback service — the media notification
         (play/pause from the shade/lock screen) and background audio
         both depend on it. POST_NOTIFICATIONS is runtime-granted on
         Android 13+ (asked in MainActivity the first time playback
         starts); the two foreground-service permissions are normal
         (install-time) declarations. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Local (LOCAL source type) video files are accessed exclusively
         via Storage Access Framework tree URIs (see LocalSourceFileSystem)
         — no broad storage permission is requested. -->

    <application
        android:name=".LocalTubeApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalTube"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.LocalTube"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hosts the single ExoPlayer + MediaSession (see
             playback/PlaybackService): gives the app its system media
             notification and audio-focus handling, and keeps audio
             running while the UI is backgrounded. The media3 action is
             what lets MediaController/Assistant connect. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- LocalTubeApplication implements Configuration.Provider, so
             WorkManager must be initialized on demand with our custom
             configuration. Remove the library's default initializer from
             the merged manifest (lintVital enforces this). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
