<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- SMB access happens over the local network, not general internet,
         but Android does not distinguish — both permissions are needed
         for smbj sockets to work. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Required for WorkManager's periodic background scan to survive
         Doze/app-standby restrictions on the schedule the user configures. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Local (LOCAL source type) video files are accessed exclusively
         via Storage Access Framework tree URIs (see LocalSourceFileSystem)
         — no broad storage permission is requested. -->

    <application
        android:name=".LocalTubeApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalTube"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LocalTube">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- LocalTubeApplication implements Configuration.Provider, so
             WorkManager must be initialized on demand with our custom
             configuration. Remove the library's default initializer from
             the merged manifest (lintVital enforces this). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
